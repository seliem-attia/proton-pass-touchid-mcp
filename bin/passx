#!/bin/bash
# passx — Proton Pass CLI without the macOS password prompt, with a Touch-ID-gated session key.
# Reads the env-provider key from the login keychain (Touch ID) and runs pass-cli.
# Examples:  passx vault list
#            PROTON_PASS_AGENT_REASON="deploy" passx item view --vault-name "Apps" --item-title "X" --field password
set -euo pipefail
BASE="${PASS_AGENT_HOME:-$HOME/.config/proton-pass-agent}"
SERVICE="${PASS_AGENT_KEYCHAIN_SERVICE:-proton-pass-agent}"
PASS_CLI="${PASS_CLI_BIN:-$(command -v pass-cli || echo /opt/homebrew/bin/pass-cli)}"
KEY="$("$BASE/pass-keychain" read "$SERVICE" encryption-key "pass-cli (terminal): $*")"
exec env \
  PROTON_PASS_KEY_PROVIDER=env \
  PROTON_PASS_ENCRYPTION_KEY="$KEY" \
  PROTON_PASS_SESSION_DIR="${PASS_AGENT_SESSION_DIR:-$BASE/session}" \
  "$PASS_CLI" "$@"
